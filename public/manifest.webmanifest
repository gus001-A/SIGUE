{
    "id": "/",
    "name": "SIGUE · Sistema Integral de Gestión Universal Educativa",
    "short_name": "SIGUE",
    "description": "Gestión escolar: alumnos, docentes, calificaciones, asistencias, pagos y comunicación con las familias.",
    "lang": "es-MX",
    "start_url": "/?origen=app",
    "scope": "/",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#f3f7fa",
    "theme_color": "#1d7fc9",
    "categories": [
        "education",
        "productivity"
    ],
    "icons": [
        {
            "src": "/images/pwa/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/images/pwa/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/images/pwa/maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Inicio",
            "url": "/?origen=app",
            "icons": [
                {
                    "src": "/images/pwa/icon-192.png",
                    "sizes": "192x192"
                }
            ]
        },
        {
            "name": "Mensajes",
            "url": "/mensajes?origen=app",
            "icons": [
                {
                    "src": "/images/pwa/icon-192.png",
                    "sizes": "192x192"
                }
            ]
        }
    ],
    "display_override": [
        "standalone",
        "minimal-ui"
    ],
    "launch_handler": {
        "client_mode": [
            "navigate-existing",
            "auto"
        ]
    },
    "handle_links": "preferred"
}